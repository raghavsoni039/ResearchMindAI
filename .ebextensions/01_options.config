# ==============================================================================
# AWS Elastic Beanstalk Configuration — Persistent Storage & Security
# ==============================================================================

option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "3000"
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

container_commands:
  01_mkdir_volumes:
    command: "mkdir -p /var/app/current/backend/app/uploads /var/app/current/backend/chroma_db /var/app/current/backend/storage/chat_history"
